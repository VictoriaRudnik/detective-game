# Copy to apps/server/.env (never commit the real file).

# Which AI writes the cases and plays the suspects: claude (default) or groq
# LLM_PROVIDER=claude
ANTHROPIC_API_KEY=

# Groq (free plan available): get a key at https://console.groq.com/keys
# LLM_PROVIDER=groq
# GROQ_API_KEY=

# Optional model overrides (defaults: claude-opus-5-5 for Claude, openai/gpt-oss-120b for Groq)
# CASE_MODEL=
# SUSPECT_MODEL=
# PORT=3001

# Play without any API calls (canned case and answers); wins over LLM_PROVIDER:
# LLM_MODE=fake
